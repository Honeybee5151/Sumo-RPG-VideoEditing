{
  "name": "sumo-rpg-video-editing",
  "productName": "Sumo VideoEditor",
  "version": "0.0.11",
  "private": true,
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Honeybee5151/Sumo-RPG-VideoEditing.git"
  },
  "build": {
    "appId": "com.sumo.videoeditor",
    "productName": "Sumo VideoEditor",
    "win": {
      "icon": "public/sumo-icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Honeybee5151",
        "repo": "Sumo-RPG-VideoEditing",
        "releaseType": "release"
      }
    ]
  },
  "scripts": {
    "postinstall": "node scripts/set-electron-icon.cjs",
    "dev": "next dev",
    "app": "node scripts/set-electron-icon.cjs && electron electron/main.cjs",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "electron": "^35.0.0",
    "postcss": "^8.5.2",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3"
  }
}
